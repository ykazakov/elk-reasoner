Prefix(:=<http://www.example.org/reasonerTester#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology (
  Declaration(NamedIndividual(:a))
  Declaration(Class(:B))
  Declaration(Class(:C))
  Declaration(Class(:D))
  Declaration(Class(:E))
  Declaration(DataProperty(:dr))

  # Different literals equivalence implies B is Nothing.
  # Thus a assertion is inconsistent.
  EquivalentClasses(
      DataHasValue(:dr "s1"@fr)
      DataHasValue(:dr "s2")
      :B
  )

  DisjointClasses(
      DataHasValue(:dr "s2")
      DataHasValue(:dr "s1"@en)
  )

  # Check correct equivalence evaluation internally (s1 != s1@fr)
  DisjointClasses(
      DataHasValue(:dr "s1"^^xsd:string)
      DataHasValue(:dr "s1"@fr)
  )

  EquivalentClasses(
      DataHasValue(:dr "s1"^^xsd:string)
      :C
  )

  EquivalentClasses(
      DataHasValue(:dr "s1"@fr)
      :D
  )

  # "s1" and "s1"@fr
  DisjointClasses(
      DataHasValue(:dr "s1")
      DataHasValue(:dr "s1"@fr)
  )

  ClassAssertion(:B :a)
)
